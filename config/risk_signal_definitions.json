{
  "version": "1.1",
  "score_scale": {
    "min": 0,
    "max": 100,
    "higher_score_means": "higher credit risk"
  },
  "scoring_method": "score = sum(weight_i * strength_i); strength_i linearly interpolated 0..1 between trigger and saturation; weights sum to 100",
  "classification": [
    {
      "category": "Low",
      "min": 0,
      "max": 24,
      "monitoring_status": "Routine"
    },
    {
      "category": "Medium",
      "min": 25,
      "max": 49,
      "monitoring_status": "Watch"
    },
    {
      "category": "High",
      "min": 50,
      "max": 74,
      "monitoring_status": "Investigate"
    },
    {
      "category": "Critical",
      "min": 75,
      "max": 100,
      "monitoring_status": "Escalate"
    }
  ],
  "modifiers": {
    "temporary_missed_payment_dampener": {
      "applies_when": {
        "late_instalments_in_window_max": 1,
        "clean_instalments_before_min": 3,
        "recovered_within_instalments": 2
      },
      "multiplier_on_repayment_signals_with_evidence": 0.25,
      "multiplier_on_repayment_signals_without_evidence": 0.6
    },
    "missing_data_policy": {
      "min_repayment_months": 4,
      "min_transaction_months": 3,
      "behaviour": "skip signals whose data requirement is unmet and renormalise weights; never add points for missing data; if too little data remains, report status 'Insufficient data' instead of a risk category"
    },
    "confidence": "share of total signal weight that could be evaluated with sufficient data (0-1)"
  },
  "signals": [
    {
      "signal_id": "RB01",
      "signal_name": "Late payment frequency",
      "scenario": "Repayment Behaviour Deterioration",
      "metric": "late_instalments_in_window (dpd>0)",
      "window_months": 6,
      "direction": "higher_is_worse",
      "trigger": 2,
      "saturation": 5,
      "weight": 15,
      "requires": "repayments",
      "min_observations": 3
    },
    {
      "signal_id": "RB02",
      "signal_name": "DPD trend rising",
      "scenario": "Repayment Behaviour Deterioration",
      "metric": "slope_of_dpd_per_month (days/month)",
      "window_months": 6,
      "direction": "higher_is_worse",
      "trigger": 1.0,
      "saturation": 6.0,
      "weight": 12,
      "requires": "repayments",
      "min_observations": 4
    },
    {
      "signal_id": "RB03",
      "signal_name": "Partial payment frequency",
      "scenario": "Repayment Behaviour Deterioration",
      "metric": "partially_paid_instalments_in_window",
      "window_months": 6,
      "direction": "higher_is_worse",
      "trigger": 1,
      "saturation": 3,
      "weight": 6,
      "requires": "repayments",
      "min_observations": 3
    },
    {
      "signal_id": "RB04",
      "signal_name": "Current delinquency",
      "scenario": "Early Delinquency and Roll-Forward Risk",
      "metric": "current_dpd",
      "window_months": 0,
      "direction": "higher_is_worse",
      "trigger": 1,
      "saturation": 60,
      "weight": 14,
      "requires": "delinquency",
      "min_observations": 1
    },
    {
