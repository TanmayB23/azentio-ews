# Copy to .env (git ignores it) and fill in. Variables already set in the
# environment take priority over this file. Used by `python -m api`.

# OpenAI key for AI case notes. Leave empty to draft notes from rules.
OPENAI_API_KEY=

# OpenAI model for case notes; must be available to your key.
EWS_AI_MODEL=gpt-4.1-mini

# Set to 0 to turn AI drafting off even with a key.
# EWS_AI_ENABLED=1

# Set to 1 to include customer names in what is sent to OpenAI (off by default).
# EWS_AI_SEND_NAMES=1
